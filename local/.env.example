APP_ENV=development
LOG_LEVEL=INFO

# Host-side database URL, used by uv commands run outside Docker.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/meeting_transcripts
POSTGRES_DB=meeting_transcripts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
API_PORT=8000

# Required only for routes or scripts that call OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
